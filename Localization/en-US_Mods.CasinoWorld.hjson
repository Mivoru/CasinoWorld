	HighRollersRing: {
		DisplayName: High Roller's Ring
		Tooltip:
			'''
			+2 Luck
			8% increased gambler damage
			'''
	}

	MartingaleMedallion: {
		DisplayName: Martingale Medallion
		Tooltip:
			'''
			Each gambler hit without a jackpot adds 2% jackpot chance
			A jackpot resets the bonus
			'Double down. It worked last time.'
			'''
	}

	DealersVisor: {
		DisplayName: Dealer's Visor
		Tooltip:
			'''
			+2 Luck
			3% increased jackpot chance
			'''
	}

	WhiteFedora: {
		DisplayName: White Fedora
		Tooltip: "'Only for those who win'"
	}

	WhiteTuxedo: {
		DisplayName: White Tuxedo
		Tooltip: "'Spotless. Like your record at the tables.'"
