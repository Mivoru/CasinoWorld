Items: {
	CasinoDoorItem: {
		DisplayName: Casino Door
		Tooltip:
			'''
			Leads into the casino
			[Development item]
			'''
	}

	CasinoBlueprint: {
		DisplayName: Casino Blueprint
		Tooltip:
			'''
			Builds the casino where you point
			Clears the space it is built on
			Use it again to move the casino
			'''
		Valid: Build the casino here
		Invalid: "Can't build here: needs solid ground, no chests or water"
		Built: The casino is open for business!
	}

	LoyaltyToken: {
		DisplayName: Loyalty Token
		Tooltip:
			'''
			Earned by betting at the casino tables
			Spend it at the prize counter
			'''
		Currency: Loyalty Tokens
	}

	GamblerFedora: {
		DisplayName: Gambler's Fedora
		Tooltip:
			'''
			+1 Luck
			5% increased gambler damage
			'''
		SetBonus:
			'''
			+3 Luck
			Jackpots put you on a Hot Streak: 10% increased gambler damage
			'''
	}

	GamblerVest: {
		DisplayName: Gambler's Vest
		Tooltip: +2 Luck
	}

	GamblerShoes: {
		DisplayName: Gambler's Shoes
		Tooltip:
			'''
			+1 Luck
			5% increased movement speed
			'''
	}

	FourLeafClover: {
		DisplayName: Four-Leaf Clover
		Tooltip: +2 Luck
	}

	AceUpTheSleeve: {
		DisplayName: Ace Up the Sleeve
		Tooltip: 3% increased jackpot chance
	}

	GolexWatch: {
		DisplayName: Golex Watch
		Tooltip:
			'''
			Displays your movement speed
			Lets everyone know you are doing just fine
			'''
	}

	Gamblorghini: {
		DisplayName: Gamblorghini
		Tooltip:
			'''
			Rides on minecart tracks
			Zero to broke in 3.2 seconds
			'''
	}

	LuckyCrate: {
		DisplayName: Lucky Crate
		Tooltip:
			'''
			<right> to open
			Blue 60%, Purple 25%, Pink 10%, Red 4%, Gold 1%
			'''
	}

	HighRollerCrate: {
		DisplayName: High Roller Crate
		Tooltip:
			'''
			<right> to open
			Hardmode loot. Blue 60%, Purple 25%, Pink 10%, Red 4%, Gold 1%
			'''
	}

	SnakeEyes: {
		DisplayName: Snake Eyes
		Tooltip: Throws a die that bounces and explodes
	}

	RoyalFlush: {
		DisplayName: Royal Flush
		Tooltip: Throws five homing cards
	}

	JackpotCannon: {
		DisplayName: Jackpot Cannon
		Tooltip: Fires a heavy chip that ricochets to two more enemies
	}

	LoadedDice: {
		DisplayName: Loaded Dice
		Tooltip: Throws a die that bounces along the ground
	}

	CardDeck: {
		DisplayName: Deck of Cards
		Tooltip: Throws a fan of three cards
	}

	HighRoller: {
		DisplayName: High Roller
		Tooltip: Flicks a chip that ricochets to another enemy
	}
}

