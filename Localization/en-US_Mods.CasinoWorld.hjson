Items: {
	CasinoDoorItem: {
		DisplayName: Casino Door
		Tooltip:
			'''
			Leads into the casino
			[Development item]
			'''
	}

	CasinoBlueprint: {
		DisplayName: Casino Blueprint
		Tooltip:
			'''
			Builds the casino where you point
			Clears the space it is built on
			Use it again to move the casino
			'''
		Valid: Build the casino here
		Invalid: Can't build here: needs solid ground, no chests or water
		Built: The casino is open for business!
	}

	LoyaltyToken: {
		DisplayName: Loyalty Token
		Tooltip:
			'''
			Earned by betting at the casino tables
			Spend it at the prize counter
			'''
		Currency: Loyalty Tokens
	}

	GamblerFedora: {
		DisplayName: Gambler's Fedora
		Tooltip:
			'''
			+1 Luck
			5% increased gambler damage
