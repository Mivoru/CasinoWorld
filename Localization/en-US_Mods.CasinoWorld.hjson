			Label: Announcements
			Tooltip: Chat messages about the hardmode casino opening and where to find it.
		}

		HighStakesNight: {
			Label: High Stakes Night
			Tooltip: In hardmode, the card army can raid the world on some nights.
		}
	}
}

BossChecklist: {
	FortunaSpawn: Use a [i:CasinoWorld/FatefulCoin] anywhere outside the casinos after defeating the Moon Lord.
	PitBossSpawn: Use a [i:CasinoWorld/VaultKey] inside the High Rollers casino after defeating a mechanical boss.
	WildCardSpawn: Use a [i:CasinoWorld/GoldenChip] at night outside the casinos. Crafted from Loyalty Tokens and gold or platinum bars.
}

